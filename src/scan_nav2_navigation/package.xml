<?xml version="1.0"?>
<package format="3">
  <name>scan_nav2_navigation</name>
  <version>0.1.0</version>
  <description>Nav2 global planning bridge for SCAN-Planner local trajectory planning.</description>
  <maintainer email="maintainer@example.com">Go2 navigation maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>open3d_loc</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>scan_planner</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
